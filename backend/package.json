{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node --max-old-space-size=1024 dist/server.js",
    "server": "node --max-old-space-size=1024 dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "NODE_ENV=test node --import tsx --test --test-force-exit test/functional/unit/*.test.ts test/functional/integration/*.test.ts test/non-functional/security/*.test.ts test/non-functional/performance/*.test.ts",
    "test:functional": "NODE_ENV=test node --import tsx --test --test-force-exit test/functional/**/*.test.ts",
    "test:unit": "NODE_ENV=test node --import tsx --test --test-force-exit test/functional/unit/*.test.ts",
    "test:integration": "NODE_ENV=test node --import tsx --test --test-force-exit test/functional/integration/*.test.ts",
    "test:non-functional": "NODE_ENV=test node --import tsx --test --test-force-exit test/non-functional/security/*.test.ts test/non-functional/performance/*.test.ts",
    "test:security": "NODE_ENV=test node --import tsx --test --test-force-exit test/non-functional/security/*.test.ts",
    "test:perf": "node --import tsx --test --test-force-exit test/non-functional/performance/internalLatencyBenchmark.ts",
    "test:k6:load": "k6 run test/non-functional/performance/k6-load-test.js",
    "test:k6:spike": "k6 run test/non-functional/performance/k6-spike-flashsale.js",
    "db:migrate": "prisma migrate deploy",
    "db:backup": "tsx scripts/backup.ts",
    "db:reindex": "tsx scripts/reindex.ts",
    "logs:status": "tsx scripts/logManager.ts --status",
    "logs:rotate": "tsx scripts/logManager.ts --rotate",
    "logs:bundle": "tsx scripts/logManager.ts --bundle",
    "logs:prune": "tsx scripts/logManager.ts --prune",
    "logs:purge": "tsx scripts/logManager.ts --purge",
    "logs:maintenance": "tsx scripts/logManager.ts --all",
    "scan:secrets": "tsx scripts/scanSecrets.ts",
    "seed": "tsx src/seed/index.ts",
    "seed:all": "tsx src/seed/index.ts",
    "seed:categories": "tsx src/seed/categorySeeder.ts",
    "seed:users": "tsx src/seed/userSeeder.ts",
    "seed:products": "tsx src/seed/productSeeder.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@prisma/extension-read-replicas": "^0.4.1",
    "@types/hpp": "^0.2.7",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-slow-down": "^3.1.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.11",
    "midtrans-client": "^1.4.3",
    "multer": "^2.3.0",
    "nodemailer": "^10.5.0",
    "otplib": "^13.5.0",
    "pg": "^8.22.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "string-similarity": "^4.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
