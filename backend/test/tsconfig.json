{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": [
      "../node_modules/@types"
    ]
  },
  "include": [
    "./**/*",
    "../src/types/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
